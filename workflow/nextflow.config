// Run from the repository root:  pixi run nextflow run workflow/main.nf -params-file config/params.yaml -profile pixi,slurm

// SLURM partitions (used by the `slurm` profile); override in config/params.yaml or with --partition / --fcsgx_partition
params {
    partition = 'epyc'
    fcsgx_partition = 'highmem'
}

process {
    cpus = 4
    memory = 16.GB
    time = 12.h
    withName: SIMULATE_SHORT {
        cpus = 8
    }
    // badread is single-threaded
    withName: SIMULATE_LONG_FUNGUS {
        time = 48.h
    }
    withName: 'CP00_RAW_BASELINE|CP01_MITO_FILTERED_ASM|CP05_SORTED|CP01_LONG_ASM|CP05_LONG_POLISHED_SORTED' {
        cpus = 16
        memory = 64.GB
        time = 48.h
    }
    // ~470 GB DB in RAM
    withName: CP03_FCSGX {
        cpus = 16
        memory = 512.GB
    }
    withName: 'QUAST|COMPLEASM|BUSCO|MINIMAP2_COMBINED' {
        cpus = 8
        memory = 32.GB
    }
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    fields = 'task_id,name,tag,status,realtime,%cpu,cpus,peak_rss,rchar,wchar'
}
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            queue = { params.partition }
            // FCS-GX loads its ~470 GB database into RAM
            withName: CP03_FCSGX {
                queue = { params.fcsgx_partition }
            }
        }
    }
    // Tools from the pixi environments in ../pixi.toml (run `pixi install --all` first).
    // Each task activates its environment itself, so this also works on SLURM nodes.
    pixi {
        process.beforeScript = "eval \"\$(pixi shell-hook --manifest-path ${projectDir}/../pixi.toml -e default)\""
        process {
            withName: 'QUAST|COMPLEASM' {
                beforeScript = "eval \"\$(pixi shell-hook --manifest-path ${projectDir}/../pixi.toml -e eval)\""
            }
            withName: BUSCO {
                beforeScript = "eval \"\$(pixi shell-hook --manifest-path ${projectDir}/../pixi.toml -e busco)\""
            }
        }
    }
}
