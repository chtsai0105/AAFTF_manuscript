// Run from the repository root:  pixi run nextflow run workflow/main.nf -params-file config/params.yaml -profile pixi,slurm

// SLURM partitions (used by the `slurm` profile); override in config/params.yaml or with --partition / --fcsgx_partition
params {
    partition = 'epyc'
    fcsgx_partition = 'highmem'
}

process {
    // fail a task when any command in a pipe fails (e.g. `badread ... | gzip`), not only the last one
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 4
    memory = 16.GB
    time = 12.h
    withName: SIMULATE_ILLUMINA {
        cpus = 8
    }
    // badread is single-threaded
    withName: SIMULATE_ONT_FUNGUS {
        time = 48.h
    }
    withName: 'CP00_RAW_BASELINE|CP01_SPADES_ASM|CP01_FLYE_ASM|CP06_POLISH' {
        cpus = 16
        memory = 64.GB
        time = 48.h
    }
    // ~470 GB DB in RAM
    // one job for all assemblies: copies the ~470 GB database once to node-local $TMPDIR and keeps it in RAM
    withName: CP03_FCSGX {
        cpus = 16
        memory = 512.GB
        time = 48.h
    }
    // bwa read mapping
    withName: CP04_COVPURGE {
        cpus = 8
        memory = 32.GB
    }
    withName: 'QUAST|MAP_TO_COMBINED_REF|DOTPLOT_PAF' {
        cpus = 8
        memory = 32.GB
    }
    // test run (S. cerevisiae): BUSCO used ~3 CPUs and 3.7 GB
    withName: BUSCO {
        cpus = 4
        memory = 16.GB
    }
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    fields = 'task_id,name,tag,status,realtime,%cpu,cpus,peak_rss,rchar,wchar'
}
report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            queue = { params.partition }
            // FCS-GX loads its ~470 GB database into RAM
            withName: CP03_FCSGX {
                queue = { params.fcsgx_partition }
            }
        }
    }
    // Tools from the pixi environments in ../pixi.toml (run `pixi install --all` first).
    // Each task activates its environment itself, so this also works on SLURM nodes.
    // --shell bash: task scripts run in bash, whatever the login shell ($SHELL) is.
    // If activation fails (e.g. pixi.toml not visible on the node), the task stops with an error.
    pixi {
        process.beforeScript = "eval \"\$(pixi shell-hook --shell bash --manifest-path ${projectDir}/../pixi.toml -e default || echo 'echo ERROR: pixi shell-hook failed for environment default >&2; exit 1')\""
        process {
            withName: QUAST {
                beforeScript = "eval \"\$(pixi shell-hook --shell bash --manifest-path ${projectDir}/../pixi.toml -e eval || echo 'echo ERROR: pixi shell-hook failed for environment eval >&2; exit 1')\""
            }
            withName: BUSCO {
                beforeScript = "eval \"\$(pixi shell-hook --shell bash --manifest-path ${projectDir}/../pixi.toml -e busco || echo 'echo ERROR: pixi shell-hook failed for environment busco >&2; exit 1')\""
            }
        }
    }
}
